<div id="userList"></div>

<script src="~/js/CreateTable.js"></script>
<script>
    const userList = document.getElementById('userList');
    loadUser();

    async function loadUser() {
        userList.innerHTML = '';
        const response = await fetch('/Account/GetAllUsers');
        const result = await response.json();

        let data = {};
        data.head = [];
        data.body = [];

        data.head = ['Email','Role','StatusBlock']
        data.body = result.map(i => ({ id: i.id, field: [i.email, i.role,i.isBlocked] }));

        const table = createTable(data, 'selectAll', 'checkboxUserList', deleteUsers);
        userList?.appendChild(table);
        
        const btnBlock = createBtnBlock();
        const btnUnblock = createBtnUnblock();
        const btnMakeAdmin = createBtnMakeAdmin();
        const btnRemoveAdmin = createBtnRemoveAdmin();

        userList?.appendChild(table);
        userList?.appendChild(btnBlock);
        userList?.appendChild(btnUnblock);
        userList?.appendChild(btnMakeAdmin);
        userList?.appendChild(btnRemoveAdmin);
    }

    
    function createBtnRemoveAdmin() { 
        const btnRemoveAdmin = document.createElement('button');
        btnRemoveAdmin.textContent = 'RemoveAdmin';
        btnRemoveAdmin.addEventListener('click', async () => {
            const userIds = getSelected();

            const request = {
                ids: userIds,
                status: 'Registered',
            };

            const response = await fetch(`/Account/SetStatus`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body:  JSON.stringify(request)
            }); 

            loadUser();
        });

        return btnRemoveAdmin;
    }

    function createBtnMakeAdmin() { 
        const btnMakeAdmin = document.createElement('button');
        btnMakeAdmin.textContent = 'MakeAdmin';
        btnMakeAdmin.addEventListener('click', async () => {
            const userIds = getSelected();

            const request = {
                ids: userIds,
                status: 'Admin',
            };

            const response = await fetch(`/Account/SetStatus`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body:  JSON.stringify(request)
            }); 

            loadUser();
        });

        return btnMakeAdmin;
    }

    function createBtnBlock() { 
        const btnBlock = document.createElement('button');
        btnBlock.textContent = 'Block';
        btnBlock.addEventListener('click', async () => {
            const userIds = getSelected();

            const response = await fetch(`/Account/BlockUsers`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(userIds)
            }); 

            loadUser();
        });

        return btnBlock;
    }

    function createBtnUnblock() { 
        const btnUnblock = document.createElement('button');
        btnUnblock.textContent = 'Unblock';
        btnUnblock.addEventListener('click', async () => {
            const userIds = getSelected();

            const response = await fetch(`/Account/UnblockUsers`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(userIds)
            });

            loadUser();
        });

        return btnUnblock;
    }

    function getSelected() {
        const res = document.getElementsByClassName('checkboxUserList');
        const userIds = Array.from(res)
            .filter(i => i.checked)
            .map(i => i.dataset.id);

        return userIds;
    }

    async function deleteUsers(usersId) { 
        await fetch('/Account/DeleteUsers', {
            method: 'DELETE',
            headers: {
                'Content-type': 'application/json'
            },
            body: JSON.stringify(usersId)
        });

        loadUser();
    }
</script>