<div id="inventoryList"></div>

<h3>@User.Identity.Name</h3>
<h3>@User.IsInRole("Admin")</h3>
<h3>@User.IsInRole("Registered")</h3>

<a href="/Account/AllUsers">All User</a>

<form asp-controller="Account" asp-action="Logout" method="post">
    <button type="submit">Logout</button>
</form>

<form asp-controller="Home" asp-action="Inventory" method="get">
    <input name="idInventory" type="number">
    <button type="submit">Go to inventory</button>
</form> 

<div>
    <input id="idInventory" type="number">
    <input id="nameInventory" type="text">
    <button onclick="addInventory()" type="submit">Add inventory</button>
</div>

<script src="~/js/CreateTable.js"></script>
<script>
    const idInventory = document.getElementById('idInventory');
    const nameInventory = document.getElementById('nameInventory');
    const inventoryList = document.getElementById('inventoryList');

    loadInventory();

    let allInventory = [];

    function updateInventoryList() { 
        inventoryList.innerHTML = '';

        let data = {
            head:[],
            body:[]
        };
        data.head = ['Name','Id'];
        for (let item of allInventory) {
            const link = `<a href="/Home/Inventory?idInventory=${item.id}">${item.name}</a>`;

            data.body.push([link,item.id]);
        }
        
        const table = createTable(data,'checkboxInventoryList','selectAll');
        inventoryList.appendChild(table);
    }

    async function addInventory()
    {
        const id = idInventory.value;
        const name = nameInventory.value;

        const item = {
            id:id,
            name:name
        };

        const response = await fetch('/Home/AddInventory',{
            method: 'POST',
            headers:{
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        console.log(result);
        allInventory.push(result);
        updateInventoryList();
    }

    async function loadInventory() { 
        let response = await fetch('/Home/GetAllInventory');
        const result = await response.json();
        console.log(result);
        allInventory = result;
        updateInventoryList();
    }
</script>