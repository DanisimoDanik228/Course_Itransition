@using Domain.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@{
    var classNameCheckBox = "checkboxInventoryList";
}

<a href="/User/AllUsers">All User</a>
<form asp-controller="User" asp-action="Logout" method="post">
    <button type="submit">Logout</button>
</form>

<h3>Your name is @User.Identity.Name</h3>
@if (@User.IsInRole("Admin"))
{
    <h3>Your role is Admin</h3>
}
else
{
    @if (@User.IsInRole("Registered"))
    {
        <h3>Your role is Registered</h3>
    }
    else
    {
        <h3>Your role is Anonym</h3>
    }
}

<div id="myInventoryList" class="bg-info bg-opacity-50"></div>
<div class="bg-info">
    <table>
        <thead>
            <tr>
                <th>
                    <input type="checkbox" id="selectAll">
                </th>
                <th>Name</th>
                <th>Id</th>
            </tr>
        </thead>
        <tbody id="inventoryList">
        </tbody>
    </table>
    <button onclick="deleteInventory()">Delete</button>
</div>

<div>
    <input id="idInventory" type="number">
    <input id="nameInventory" type="text">
    <button onclick="addInventory()" type="submit">Add inventory</button>
</div>

<script src="~/js/MainFunction.js"></script>
<script>
    const myId = "@UserManager.GetUserId(User)";

    let allInventory = [];
    let myInventory = [];

    getInventory();
    getMyInventory();
    
    loadInventory();
    loadMyInventory();

    createClickSelectAll('selectAll','@classNameCheckBox');

    function loadMyInventory() {
        const myInventoryList = document.getElementById('myInventoryList');
        let resHtml = "";

        for (let item of myInventory) { 
            resHtml += `<a href="/Home/Inventory?Id=${item.id}&Page=1&Count=5">${item.name}</a>`;
        }

        myInventoryList.innerHTML = resHtml;
    }

    function loadInventory() { 
        const inventoryList = document.getElementById('inventoryList');
        let resHtml = "";

        for (let item of allInventory) {
            resHtml += `
            <tr>
                <td>
                    <input type="checkbox" class="@classNameCheckBox" data-id="123">
                </td>
                <td>
                    <a href="/Home/Inventory?Id=${item.id}&Page=1&Count=5">${item.name}</a>
                </td>
            </tr>`;
        }
        
        inventoryList.innerHTML = resHtml;
    }

    async function deleteInventory()
    {
        const inventoryIds = getSelected('@classNameCheckBox');
        await DeleteInventory(inventoryIds);

        getInventory();
        getMyInventory()
        loadInventory();
        loadMyInventory();
    }

    async function addInventory()
    {
        const id = document.getElementById('idInventory').value;
        const name = document.getElementById('nameInventory').value;

        const item = {
            id:id,
            name:name,
            creatorId: myId
        };

        const response = await AddInventory(item);
        const result = await response.json();

        getInventory();
        getMyInventory()
        loadInventory();
        loadMyInventory();
    }

    async function getInventory() { 
        const response = await GetAllInventory();
        const result = await response.json();
        allInventory = result;

        loadInventory();
        loadMyInventory();
    }

    async function getMyInventory() {
        const response = await GetAllUserInventories(myId);
        const result = await response.json();
        myInventory = result;

        loadInventory();
        loadMyInventory();
    }
</script>