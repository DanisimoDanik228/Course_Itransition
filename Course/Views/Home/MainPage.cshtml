<div>
    <div class="d-flex justify-content-between border-bottom">
        <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/Home/PersonalPage" class="">
            Personal Page
        </a>
        <button onclick="changeTheme()" class="btn btn-outline-secondary btn-sm rounded-2">
            Theme
        </button>
    </div>
    <div class="table-responsive rounded border p-2">
        <table class="table table-bordered table-hover mb-0">
            <thead>
                <tr class="text-uppercase">
                    <th>Name</th>
                    <th>Description</th>
                    <th>Creator</th>
                </tr>
            </thead>
            <tbody id="inventoryTableBody">
            </tbody>
        </table>
    </div>
</div>
<script>
    let inventories = [];
    
    loadInventories();

    async function loadInventories() {
        inventories = await (await GetAllInventory()).json();
        
        let resHtml = "";

        for(let item of inventories){
            resHtml += `
                <tr>
                    <td>
                        <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2 fw-bold text-decoration-none" href="/Home/Inventory?Id=0&InventoryId=${item.id}">
                            ${item.name}
                        </a>
                    </td>
                    <td>${item.description}</td>
                    <td>${item.creatorName}</td>
                </tr>
                `;
        }

        document.getElementById('inventoryTableBody').innerHTML = resHtml;
    }

    function changeTheme() { 
        const htmlEl = document.documentElement;
        const currentTheme = htmlEl.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        htmlEl.setAttribute('data-bs-theme', newTheme);
        localStorage.setItem('theme', newTheme)
    }
</script>