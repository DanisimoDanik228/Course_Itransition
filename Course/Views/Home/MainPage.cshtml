<div>
    <div>
        <a href="/Home/PersonalPage" class="">Personal Page</a>
        <button onclick="changeTheme()" class="btn btn-outline-secondary btn-sm rounded-2">
            Theme
        </button>
    </div>
    <div>
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Creator</th>
                </tr>
            </thead>
            <tbody id="inventoryTableBody">
            </tbody>
        </table>
    </div>
</div>
<script>
    let inventories = [];
    
    loadInventories();

    async function loadInventories() {
        inventories = await (await GetAllInventory()).json();
        
        let resHtml = "";

        for(let item of inventories){
            resHtml += `
                <tr>
                    <td>
                        <a href="/Home/Inventory?Id=0&InventoryId=${item.id}">${item.name}</a>
                    </td>
                    <td>${item.description}</td>
                    <td>${item.creatorName}</td>
                </tr>
                `;
        }

        document.getElementById('inventoryTableBody').innerHTML = resHtml;
    }

    function changeTheme() { 
        const htmlEl = document.documentElement;
        const currentTheme = htmlEl.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        htmlEl.setAttribute('data-bs-theme', newTheme);
        localStorage.setItem('theme', newTheme)
    }
</script>