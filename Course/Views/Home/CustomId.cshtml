<style>
    .drag-item {
        border: 2px solid green;
    }

    .drag-over {
        border-top: 3px solid blue;
    }
</style>
<div id="listPartsCustomId"></div>
<div id="container" class="border border-black border-3 m-3">
    
</div>
<button onclick="saveCustomId()">Save</button>
<button onclick="getCustomIdExample()">Generate Example</button>

<script>
    let partsCustomId = [];
    
    loadPartsCustomId();

    async function loadPartsCustomId() { 
        response = await GetAllPartCustomId();
        partsCustomId = await response.json();

        let resHtml = "";
        for (let part of partsCustomId) { 
            resHtml += `
            <div
                onclick="addItem('${part.typePartCustomId}','${part.name}')">
                ${part.name}
            </div>`;
        }
        document.getElementById('listPartsCustomId').innerHTML = resHtml;
    }
</script>

<script>
    let draggedId = null;    
    let selectedItems = [];

    const container = document.getElementById('container');
    renderTarget();

    container.ondragover = (e) => {
        e.preventDefault(); 
    };

    container.ondrop = (e) => {
        e.preventDefault();

        const item = selectedItems[draggedId];
        let targetId = parseInt(e.target.dataset.index);
        selectedItems.splice(draggedId, 1);
        selectedItems.splice(targetId, 0, item);

        renderTarget();
    };

    function renderTarget() {
        if (selectedItems.length === 0) {
            container.innerHTML = "Empty List";
            return;
        }

        let resHtml = "";

        for (let i = 0; i < selectedItems.length; i++) { 
            const el = selectedItems[i];

            let resSelect = "";
            const avaliableFormat = partsCustomId.find(i => i.typePartCustomId == el.id).avaliableFormat;
            if (avaliableFormat.length > 0) {
                resSelect += `<select data-id="${i}">`
            } else { 
                resSelect += `<select style="display:none;" data-id="${i}">`
            }
            
            for (let format of avaliableFormat) {
                resSelect += `
                        <option value="${format}">${format}</option>`;
            }
            resSelect += `</select>`

            resHtml += 
                `<div draggable="true"
                    data-index="${i}"
                    class="drag-item" margin: 5px;">
                    ${el.name}
                    ${resSelect}
                    <button onclick="removeItem(${i})">Delete</button>
                </div>
            `;
        }

        container.innerHTML = resHtml;

        const items = container.childNodes;
        for (let el of items) {
            el.ondragenter = (e) => el.classList.add('drag-over');
            el.ondragleave = (e) => el.classList.remove('drag-over');
            el.ondragstart = (e) => {
                draggedId = parseInt(e.target.dataset.index);
            };
        }
    }

    function removeItem(index){
        selectedItems.splice(index, 1);
        renderTarget();
    };


    async function saveCustomId() { 
        let data = [...selectedItems];
        for (let i = 0; i < data.length; i++){
            const item = data[i];
            const selectEl = document.querySelector(`div[data-index="${i}"] select`);
            if (selectEl) {
                data[i].format = selectEl.value;
            } else {
                data[i].format = '';
            }
        }
        console.log(data);
    }

    function addItem(id,name) { 
        selectedItems.push({
            id:id,
            name:name
        });

        renderTarget();
    }

    async function getCustomIdExample() { 
        
    }
</script>
