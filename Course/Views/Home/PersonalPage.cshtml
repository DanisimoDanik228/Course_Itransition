@using Domain.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@{
    var classNameMyInventoryCheckBox = "checkboxMyInventoryList";
    var classNameAccessInventoryCheckBox = "checkboxAccessInventoryList";
}

<a href="/User/AllUsers">All User</a>
<form asp-controller="User" asp-action="Logout" method="post">
    <button type="submit">Logout</button>
</form>

<h3>Your name is @User.Identity.Name</h3>
@if (@User.IsInRole("Admin"))
{
    <h3>Your role is Admin</h3>
}
else
{
    @if (@User.IsInRole("Registered"))
    {
        <h3>Your role is Registered</h3>
    }
    else
    {
        <h3>Your role is Anonym</h3>
    }
}


<div class="row">
    <div class="col-6 border border-dark">
        <h4>My Inventory</h4>
        <table>
            <thead>
                <tr>
                    <th>
                        <input type="checkbox" id="selectMyAll">
                    </th>
                    <th>Id</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody id="myInventoryList">
            </tbody>
        </table>
        <button onclick="deleteMyInventory()">Delete</button>
    </div>

    <div class="col-6 border border-dark">
        <h4>Access Inventory</h4>
        <table>
            <thead>
                <tr>
                    @if (@User.IsInRole("Admin"))
                    {
                        <th>
                            <input type="checkbox" id="selectAccessAll">
                        </th>
                    }
                    <th>Id</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody id="accessInventoryList">
            </tbody>
        </table>
        @if (@User.IsInRole("Admin"))
        {
            <button onclick="deleteAccessInventory()">Delete</button>
        }
    </div>
</div>

<div>
    <input id="nameInventory" type="text">
    <button onclick="addInventory()">Add inventory</button>
</div>

<script>
    const myId = "@UserManager.GetUserId(User)";
    const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");

    let accessInventory = [];
    let myInventory = [];

    getMyInventory();
    getAccessInventory();

    createClickSelectAll('selectMyAll', '@classNameMyInventoryCheckBox');
    if (isAdmin) { 
        createClickSelectAll('selectAccessAll', '@classNameAccessInventoryCheckBox');
    }

    async function loadMyInventory() {
        const myInventoryList = document.getElementById('myInventoryList');
        let resHtml = "";

        for (let item of myInventory) {             
            resHtml += `
            <tr>
                <td>
                    <input type="checkbox" class="@classNameMyInventoryCheckBox" data-id="${item.id}">
                </td>
                <td>
                    <a href="/Home/Inventory?Id=${item.id}&Page=1">${item.id}</a>
                </td>
                <td>${item.name}</td>
            </tr>`;
        }

        myInventoryList.innerHTML = resHtml;
    }

    async function loadAccessInventory() {
        const accessInventoryList = document.getElementById('accessInventoryList');
        let resHtml = "";

        for (let item of accessInventory) {
            let checkbox = isAdmin
            ? ` <td>
                    <input type="checkbox" class="@classNameAccessInventoryCheckBox" data-id="${item.id}">
                </td>`
            : ``;
            resHtml += `
            <tr>
                ${checkbox}
                <td>
                    <a href="/Home/Inventory?Id=${item.id}&Page=1">${item.id}</a>
                </td>
                <td>${item.name}</td>
            </tr>`;
        }
        
        accessInventoryList.innerHTML = resHtml;
    }

    async function deleteMyInventory(){
        const inventoryIds = getSelected('@classNameMyInventoryCheckBox');
        await DeleteInventory(inventoryIds);
        
        getAccessInventory();
        getMyInventory();
    }

    async function deleteAccessInventory()  {
        const inventoryIds = getSelected('@classNameAccessInventoryCheckBox');
        await DeleteInventory(inventoryIds);
        
        getAccessInventory();
        getMyInventory();
    }

    async function addInventory(){
        const name = document.getElementById('nameInventory').value;

        const item = {
            name:name,
            creatorId: myId
        };

        await AddInventory(item);

        getAccessInventory();
        getMyInventory();
    }

    async function getAccessInventory() {
        const response = await GetAllUserAccessInventories(myId);
        const result = await response.json();
        accessInventory = result;

        loadAccessInventory();
    }

    async function getMyInventory() {
        const response = await GetAllUserInventories(myId);
        const result = await response.json();
        myInventory = result;

        loadMyInventory();
    }
</script>