@using Domain.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@{
    var classNameMyInventoryCheckBox = "checkboxMyInventoryList";
    var classNameAccessInventoryCheckBox = "checkboxAccessInventoryList";
}
<div class="table-responsive rounded border">
    <div class="d-flex justify-content-between border-bottom p-2">
        <div>
        <form asp-controller="User" asp-action="Logout" method="post">
            @if (@User.IsInRole("Admin"))
            {
            <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/User/AdminPanel">AdminPanel</a>
            }
                <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/User/Profile?Id=003dL000027eVmVQAU">Profile</a>
            <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/Home/MainPage">Main Page</a>
            <button class="btn btn-outline-info text-decoration-none btn-sm rounded-2" type="submit">Logout</button>
        </form>

        @if (@User.IsInRole("Admin"))
        {
            <h3>Your role is Admin</h3>
            <h3>Your name is @User.Identity.Name</h3>
        }
        else
        {
            @if (@User.IsInRole("Registered"))
            {
                <h3>Your role is Registered</h3>
                <h3>Your name is @User.Identity.Name</h3>
            }
            else
            {
                <h3>Your role is Anonym</h3>
                <h3>You dont have name</h3>
            }
        }
        </div>
        <div>
            <button onclick="changeTheme()" class="btn btn-outline-secondary btn-sm rounded-2">
                Theme
            </button>
        </div>
    </div>

        <div class="table-responsive rounded border mb-0">
        @if (@User.IsInRole("Registered") || User.IsInRole("Admin"))
        {
            <div class="p-2">
                <div class="col-7 border border-dark">
                    <h4>My Inventory</h4>
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <input type="checkbox" class="form-check-input" id="selectMyAll">
                                </th>
                                <th>Id</th>
                                <th>Name</th>
                            </tr>
                        </thead>
                        <tbody id="myInventoryList">
                        </tbody>
                    </table>
                    <div class="border-top p-2">
                        <button class="btn btn-outline-danger btn-sm" onclick="deleteMyInventory()">Delete</button>
                    </div>
                </div>

                <div class="col-7 border border-dark">
                    <h4>Access Inventory</h4>
                    <table class="table table-bordered table-hover mb-0">
                        <thead>
                            <tr>
                                @if (@User.IsInRole("Admin"))
                                {
                                    <th>
                                        <input type="checkbox" class="form-check-input" id="selectAccessAll">
                                    </th>
                                }
                                <th>Id</th>
                                <th>Name</th>
                            </tr>
                        </thead>
                        <tbody id="accessInventoryList">
                        </tbody>
                    </table>
                    <div class="border-top p-2">
                    @if (@User.IsInRole("Admin"))
                    {
                        <button class="btn btn-outline-danger btn-sm" onclick="deleteAccessInventory()">Delete</button>
                    }
                    </div>
                </div>
            </div>

            <div class ="btn-group p-2">
                <input id="nameInventory" type="text">
                <button class="btn btn-outline-primary btn-sm" onclick="addInventory()">Add inventory</button>
            </div>
        }
    </div>
</div>
<script>
    const myId = "@UserManager.GetUserId(User)";
    const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");

    let accessInventory = [];
    let myInventory = [];

    getMyInventory();
    getAccessInventory();

    createClickSelectAll('selectMyAll', '@classNameMyInventoryCheckBox');
    if (isAdmin) { 
        createClickSelectAll('selectAccessAll', '@classNameAccessInventoryCheckBox');
    }

    async function loadMyInventory() {
        const myInventoryList = document.getElementById('myInventoryList');
        let resHtml = "";

        for (let item of myInventory) {             
            resHtml += `
            <tr>
                <td>
                    <input type="checkbox" class="form-check-input @classNameMyInventoryCheckBox" data-id="${item.id}">
                </td>
                <td>
                    <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/Home/Inventory?Id=0&InventoryId=${item.id}">${item.id}</a>
                </td>
                <td>${item.name}</td>
            </tr>`;
        }

        myInventoryList.innerHTML = resHtml;
    }

    async function loadAccessInventory() {
        const accessInventoryList = document.getElementById('accessInventoryList');
        let resHtml = "";

        for (let item of accessInventory) {
            let checkbox = isAdmin
            ? ` <td>
                    <input type="checkbox" class="form-check-input @classNameAccessInventoryCheckBox" data-id="${item.id}">
                </td>`
            : ``;
            resHtml += `
            <tr>
                ${checkbox}
                <td>
                    <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/Home/Inventory?Id=0&InventoryId=${item.id}"">${item.id}</a>
                </td>
                <td>${item.name}</td>
            </tr>`;
        }
        
        accessInventoryList.innerHTML = resHtml;
    }

    async function deleteMyInventory(){
        const inventoryIds = getSelected('@classNameMyInventoryCheckBox');
        await DeleteInventory(inventoryIds);
        
        getAccessInventory();
        getMyInventory();
    }

    async function deleteAccessInventory()  {
        const inventoryIds = getSelected('@classNameAccessInventoryCheckBox');
        await DeleteInventory(inventoryIds);
        
        getAccessInventory();
        getMyInventory();
    }

    async function addInventory(){
        const name = document.getElementById('nameInventory').value;

        const item = {

            name:name,
            creatorId: myId
        };

        await AddInventory(item);

        getAccessInventory();
        getMyInventory();
    }

    async function getAccessInventory() {
        const response = await GetAllUserAccessInventories(myId);
        const result = await response.json();
        accessInventory = result;

        loadAccessInventory();
    }

    async function getMyInventory() {
        const response = await GetAllUserInventories(myId);
        const result = await response.json();
        myInventory = result;

        loadMyInventory();
    }
</script>