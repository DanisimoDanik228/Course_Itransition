@using Application.Dto.Response.Full
@model InventoryFullResponseDto

<table>
    <thead>
        <tr>
            @foreach (var item in Model.InventoryType)
            {
                <th> @item.Name </th>
                <th> @item.Type </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                @foreach (var item1 in item.ItemValue)
                {
                    <td>@item1.Name</td>
                    <td>@item1.Value</td>
             
                }
            </tr>
        }
    </tbody>
</table>

<div>
    @foreach (var item in Model.InventoryType)
    {
        <div>@item.Name</div>
        <input class="addItem" data-type-id="@item.Name" type="text">
    }
    <button onclick="addItem()" type="submit">Add Item</button>
</div>

<div>
    <div>Name:</div>
    <input id="fieldName" type="text">
    <div>Type:</div>
    <input id="fieldType" type="text">
    <button onclick="addField()" type="submit">Add Item</button>
</div>

<script>
    const fieldName = document.getElementById('fieldName');
    const fieldType = document.getElementById('fieldType');

    async function addItem() {
        const values = document.getElementsByClassName('addItem');
        
        let item = {};
        
        item.id = 0;
        item.inventoryId = @Model.Id;
        item.itemValue = [];

        for (let field of values) { 
            let subItem = {
                id: 0,
                value: field.value,
                type: "string",
                name: field.dataset.typeId
            };

            item.itemValue.push(subItem);
        }

        console.log(item);

        const response = await fetch(`/Home/AddItem?idInventory=${@Model.Id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        console.log(result);
    }

    async function addField() {
        const values = document.getElementsByClassName('addItem');

        let item = {};

        item.id = 0;
        item.inventoryId = @Model.Id;
        item.name = fieldName.value;
        item.type = fieldType.value;

        console.log(item);

        const response = await fetch(`/Home/AddField`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        console.log(result);
    }
</script>