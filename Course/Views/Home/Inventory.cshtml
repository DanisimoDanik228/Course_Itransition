<div id="inventoryTable"></div>

<button onclick="addItem()" type="submit">Add Item</button>
<div id="listItemField"></div>

<div>
    <button onclick="addField()" type="submit">Add Field</button>
    <div>Name</div>
    <input id="fieldName" type="text">
    <div>Type</div>
    <input id="fieldType" type="text">
</div>

<script src="~/js/CreateTable.js"></script>
<script>
    const fieldName = document.getElementById('fieldName');
    const fieldType = document.getElementById('fieldType');
    const inventoryTable = document.getElementById('inventoryTable');
    const listItemField = document.getElementById('listItemField');

    let inventory = {};

    loadFullInventory();

    async function addItem() {
        const values = document.getElementsByClassName('addItem');
        
        let item = {};
        
        item.id = 0;
        item.inventoryId = @Model;
        item.itemValue = [];

        for (let field of values) { 
            let subItem = {
                id: 0,
                value: field.value,
                type: "string",
                name: field.dataset.typeId
            };

            item.itemValue.push(subItem);
        }

        const response = await fetch(`/Home/AddItem?idInventory=${@Model}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        console.log("additem",result);
        inventory.items.push(result);
        loadFullInventory();
    }

    async function addField() {
        const values = document.getElementsByClassName('addItem');

        let item = {};

        item.id = 0;
        item.inventoryId = @Model;
        item.name = fieldName.value;
        item.type = fieldType.value;

        const response = await fetch(`/Home/AddField`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        inventory.inventoryType.push(result);

        loadFullInventory();
    }

    async function loadFullInventory() {
        inventoryTable.innerHTML = '';

        const response = await fetch(`/Home/GetFullInventory?idInventory=${@Model}`);
        const result = await response.json();

        inventory = result;

        let data = {
            head:[],
            body:[]
        };

        data.head = result.inventoryType.map(i => i.name);
        for (let item of result.items) {
            data.body.push({ id: item.id, field: item.itemValue.map(i => i.value) });
        }
        
        const table = createTable(data, 'checkboxInventoryList', 'selectAll', DeleteItem);
        inventoryTable?.appendChild(table);

        loadAddItem();
    }

    function loadAddItem() {
        while (listItemField?.firstChild) {
            listItemField.removeChild(listItemField?.firstChild);
        }

        for (let item of inventory.inventoryType) {
            const div = document.createElement('div');
            const input = document.createElement('input');

            input.className = 'addItem';
            input.setAttribute('data-type-id', item.name);
            input.type = 'text';

            div.innerText = item.name;
            listItemField.appendChild(div);
            listItemField.appendChild(input);
        }
    }

    async function DeleteItem(itemsId) { 
        await fetch(`/Home/DeleteItems?idInventory=${@Model}`, {
            method: 'DELETE',
            headers: {
                'Content-type': 'application/json'
            },
            body: JSON.stringify(itemsId)
        });

        loadFullInventory();
    }
</script>