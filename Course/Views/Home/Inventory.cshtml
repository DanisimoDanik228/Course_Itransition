<h3 id="inventoryInfo"></h3>

<div id="inventoryTable"></div>

<div class="bg-success bg-opacity-50">
    <button onclick="addItem()" type="submit">Add Item</button>
    <div id ="listItemField"></div>
</div>

<div class="bg-success bg-opacity-75">
    <button onclick="addField()" type="submit">Add Field</button>
    <div>Name</div>
    <input id="fieldName" type="text">
    <div>Type</div>
    <input id="fieldType" type="text">
</div>

<script src="~/js/CreateTable.js"></script>
<script>
    const inventoryInfo = document.getElementById('inventoryInfo');
    const fieldName = document.getElementById('fieldName');
    const fieldType = document.getElementById('fieldType');
    const inventoryTable = document.getElementById('inventoryTable');
    const listItemField = document.getElementById('listItemField');

    let inventory = {};

    loadInventory();

    async function addItem() {
        const values = document.getElementsByClassName('addItem');
        
        let item = {};
        
        item.id = 0;
        item.inventoryId = @Model;
        item.itemValue = [];

        for (let field of values) { 
            let subItem = {
                id: 0,
                value: field.value,
                inventoryTypeId: field.dataset.id
            };

            item.itemValue.push(subItem);
        }

        const response = await fetch(`/Home/AddItem?idInventory=${@Model}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        inventory.items.push(result);
        loadInventory();
    }

    function addFieldCheckbox(Ids) { 
        const thead = inventoryTable.querySelector('thead');
        const tr = document.createElement('tr');

        const th = document.createElement('th');
        tr.appendChild(th);

        for (let id of Ids) {
            const th = document.createElement('th');
            const checkBox = document.createElement('input');
            checkBox.type = 'checkbox';
            checkBox.className = 'checkboxFieldList';
            checkBox.dataset.id = id;
            th.appendChild(checkBox);

            tr.appendChild(th);
        }

        const btn = document.createElement('button');
        btn.textContent = 'Delete field';
        btn.addEventListener('click', async () => {
            const res = document.getElementsByClassName('checkboxFieldList');
            const fieldIds = Array.from(res)
                .filter(i => i.checked)
                .map(i => i.dataset.id);

            const response = await fetch(`/Home/DeleteField?idInventory=${@Model}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(fieldIds)
            }); 

            loadInventory();
        });

        thead.insertBefore(tr, thead.firstChild);
        inventoryTable.appendChild(btn);
    }

    async function addField() {
        const values = document.getElementsByClassName('addItem');

        let item = {};

        item.id = 0;
        item.inventoryId = @Model;
        item.name = fieldName.value;
        item.type = fieldType.value;

        const response = await fetch(`/Home/AddField`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(item)
        });

        const result = await response.json();
        inventory.inventoryType.push(result);

        loadInventory();
    }

     async function loadInventory() {
        inventoryTable.innerHTML = '';

        const response = await fetch(`/Home/GetPartInventory?idInventory=${@Model}&Page=${@ViewBag.Page}&Count=${@ViewBag.Count}`);
        const result = await response.json();

        inventory = result;

        const data = {
            head:[],
            body:[]
        };

        data.head = result.inventoryType.map(i => i.name);
        for (let item of result.items) {
            data.body.push({ id: item.id, field: item.itemValue.map(i => i.value) });
        }
        
        const table = createTable(data, 'checkboxInventoryList', 'selectAll', DeleteItem);
        inventoryTable?.appendChild(table);

        addFieldCheckbox(inventory.inventoryType.map(i => i.id));
        loadAddItem();
        
        inventoryInfo.innerText = `Название: ${inventory.name} | Создатель: ${inventory.creatorName}`;
    }

    function loadAddItem() {
        while (listItemField?.firstChild) {
            listItemField.removeChild(listItemField?.firstChild);
        }

        for (let item of inventory.inventoryType) {
            const div = document.createElement('div');
            const input = document.createElement('input');

            input.className = 'addItem';
            input.setAttribute('data-id', item.id);
            input.type = 'text';

            div.innerText = item.name;
            listItemField.appendChild(div);
            listItemField.appendChild(input);
        }
    }

    async function DeleteItem(itemsId) { 
        await fetch(`/Home/DeleteItems?idInventory=${@Model}`, {
            method: 'DELETE',
            headers: {
                'Content-type': 'application/json'
            },
            body: JSON.stringify(itemsId)
        });

        loadInventory();
    }
</script>