@using Application.Dto.Response.Full
@model InventoryFullResponseDto

<table>
    <thead>
        <tr>
            @foreach (var item in Model.InventoryType)
            {
                <th> @item.Name </th>
                <th> @item.Type </th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                @foreach (var item1 in item.ItemValue)
                {
                    <td>@item1.Name</td>
                    <td>@item1.Value</td>
             
                }
            </tr>
        }
    </tbody>
</table>

<div>
    <input id="idItem" type="number">
    <input id="nameInventory" type="text">
    <button onclick="addInventory()" type="submit">Add Item</button>
</div>