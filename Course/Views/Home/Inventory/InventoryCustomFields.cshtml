@model (long Id,bool isEditor, bool isCreator)
@{
    var classNameFieldCheckBox = "fieldCheckBox";
    var classNameInputField = "inputField";

    var classNameFieldName = "fieldName";
    var classNameFieldType = "fieldType";
    var classNameFieldVisible = "fieldVisible";
    var classNameFieldDesc = "fieldDesc";
}
<style>
    .drag-item {
        border: 2px solid green;
    }

    .drag-over {
        border-top: 3px solid blue;
    }
</style>
<partial name="Inventory/InventoryNavigate" model="@Model" />
<div class="table-responsive rounded border">
    <div class="p-2">
        <table class="table table-bordered table-hover mb-0">
            <thead>
                <tr>
                    <th><input type="checkbox" class="form-check-input" id="selectAll"></th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Visible</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody id="inventoryTableBody">
            </tbody>
        </table>
        <div class="border-top p-2">
            <div class="btn-group">
                <button class="btn btn-outline-primary btn-sm" onclick="addField()" type="submit">Add Field</button>
                <button class="btn btn-outline-danger btn-sm" onclick="deleteField()">Delete Field</button>
                <button class="btn btn-outline-success btn-sm" onclick="applyChanges()">Change</button>
            </div>
        </div>
    </div>
</div>
<script>
    let inventoryTypes = [];
    let orderInventoryTypes = [];
    let draggedId = null;

    loadInventoryTypes();

    createClickSelectAll('selectAll', '@classNameFieldCheckBox');
    
    async function loadInventoryTypes() {
        await getInventoryTypes();
        const allIds = inventoryTypes.map(i => i.id);
        const tableOrderField = await (await GetOrderField(@Model.Id)).json();
        orderInventoryTypes = collapseFieldOrder(tableOrderField, allIds);
        loadTableBody();
    }

    async function getInventoryTypes() {
        const response = await GetInventoryTypes(@Model.Id);
        inventoryTypes = await response.json();
    }

    function loadTableBody() {
        let resHtml = "";

        for (let id of orderInventoryTypes) {
            const field = inventoryTypes.find(i => i.id == id)
            resHtml += `
                <tr>
                    <td>
                        <input type="checkbox" class="@classNameFieldCheckBox" data-inventory-type-id="${field.id}">
                    </td>
                    <td class="border-2 drag-item" draggable="true" data-id="${field.id}" title="${field.description}">
                        <input type="text" class="@classNameFieldName" value="${field.name}" data-inventory-type-id="${id}">
                    </td>
                    <td>
                        <input type="text" class="@classNameFieldType" value="${field.type}" data-inventory-type-id="${id}">
                    </td>
                    <td>
                        <select class="@classNameFieldVisible" data-inventory-type-id="${id}">
                            <option value="1">true</option>
                            <option value="0" ${field.isShowInventoryTab ? '' : 'selected'}>false</option>
                        </select>
                    </td>
                    <td>
                        <input type="text" class="@classNameFieldDesc" value="${field.description}" data-inventory-type-id="${id}">
                    </td>
                </tr>`;
        }

        document.getElementById('inventoryTableBody').innerHTML = resHtml;
        render();
    }

    function render() {
        const dragItems = document.getElementsByClassName('drag-item');

        for (let el of dragItems) {
            el.ondragstart = (e) => draggedId = parseInt(el.dataset.id);
            el.ondragover = (e) => e.preventDefault();
            el.ondragenter = (e) => el.classList.add('drag-over');
            el.ondragleave = (e) => el.classList.remove('drag-over');

            el.ondrop = async (e) => {
                let targetId = parseInt(el.dataset.id);

                let from = orderInventoryTypes.indexOf(draggedId);
                let to = orderInventoryTypes.indexOf(targetId);

                orderInventoryTypes.splice(from, 1);
                orderInventoryTypes.splice(to, 0, draggedId);

                await UpdateOrderField(@Model.Id,orderInventoryTypes);
                loadInventoryTypes();

                render();
            }
        }
    }

    async function addField() {
        const nameField = "";
        const item = {
            id: 0,
            inventoryId: @Model.Id,
            name: nameField,
            type: 0,
            isShowInventoryTab: false,
            description: ""
        };

        await AddFieldOnInventory(item);
        await loadInventoryTypes();
    }

    async function deleteField() {
        const fields = await getSelected('@classNameFieldCheckBox', i => i.dataset.inventoryTypeId);

        await DeleteFieldOnInventory(@Model.Id, fields);

        loadInventoryTypes();
    }

    async function applyChanges() {
        const updatedFields = [];

        for (let id of orderInventoryTypes) {
            const nameInput = document.querySelector('.@classNameFieldName' + `[data-inventory-type-id="${id}"]`);
            const typeInput = document.querySelector('.@classNameFieldType' + `[data-inventory-type-id="${id}"]`);
            const visibleInput = document.querySelector('.@classNameFieldVisible' + `[data-inventory-type-id="${id}"]`);
            const descInput = document.querySelector('.@classNameFieldDesc' + `[data-inventory-type-id="${id}"]`);

            const updatedItem = {
                id: id,
                inventoryId: @Model.Id,
                name: nameInput.value,
                type: parseInt(typeInput.value),
                isShowInventoryTab: visibleInput.value === '1',
                description: descInput.value
            };

            updatedFields.push(updatedItem);
        }

        await UpdateInvertoryTypes(updatedFields);
        await UpdateOrderField(@Model.Id,orderInventoryTypes);
        loadInventoryTypes();
    }
</script>