@model (long Id,bool isEditor, bool isCreator)
<div class="d-flex justify-content-between border-bottom p-2">
    <div>
        <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/Home/PersonalPage">My PersonalPage</a>
        <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2" href="/Home/MainPage">Main Page</a>
    </div>
    <button onclick="changeTheme()" class="btn btn-outline-secondary btn-sm rounded-2">
        Theme
    </button>
</div>
<ul class="nav nav-underline border-bottom px-2">
    <li class="nav-item">
        <a class="nav-link"
           href="/Home/Inventory?Id=0&InventoryId=@Model.Id">Items</a>
    </li>
    <li class="nav-item">
        <a class="nav-link"
           href="/Home/Inventory?Id=1&InventoryId=@Model.Id">Discussion</a>
    </li>
    @if (Model.isCreator || User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link"
               href="/Home/Inventory?Id=2&InventoryId=@Model.Id">General Settings</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               href="/Home/Inventory?Id=3&InventoryId=@Model.Id">Custom Id</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               href="/Home/Inventory?Id=4&InventoryId=@Model.Id">Access Settings</a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               href="/Home/Inventory?Id=5&InventoryId=@Model.Id">Custom fields<a>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link"
            href="/Home/Inventory?Id=6&InventoryId=@Model.Id">Statistics</a>
    </li>
</ul>