@model (long Id,bool isEditor, bool isCreator)
@{
    var classNameUserCheckBox = "userCheckBox";
}

<partial name="Inventory/InventoryNavigate" model="@Model" />

<div>
    <div class="card bg-light-subtle">
        <div class="form-switch m-3">
            <input class="form-check-input" type="checkbox" id="checkBoxIsPublic">
            <label class="form-check-label fw-bold">
                Public Access
            </label>
        </div>
    </div>

    <div class="row align-items-end">
        <div class="col-4">
            <label class="small text-muted text-uppercase fw-bold">Find User</label>
            <div class="input-group">
                <input type="text" class="form-control form-control-sm" id="inputUser" oninput="searchEditor()" placeholder="Enter name or email..." />
            </div>
        </div>
        <div class="col-4">
            <div class="btn-group">
                <input type="radio" class="btn-check" name="searchField" id="userName" value="UserName" onchange="changedSearchField()" checked autocomplete="off">
                <label class="btn btn-outline-info btn-sm" for="userName">By Name</label>

                <input type="radio" class="btn-check" name="searchField" id="email" value="Email" onchange="changedSearchField()" autocomplete="off">
                <label class="btn btn-outline-info btn-sm" for="email">By Email</label>
            </div>
        </div>
    </div>
    <div class="table-responsive rounded border">
        <div class="p-2">
            <table class="table table-bordered table-hover mb-0">
                <thead>
                    <tr>
                        <th>
                            <input type="checkbox" class="form-check-input" id="selectAllUser">
                        </th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Current Role</th>
                    </tr>
                </thead>
                <tbody id="userList">
                </tbody>
            </table>
        </div>
        <div class="border-top p-2 btn-group" id="btnEditInventory">
            <button class="btn btn-outline-primary btn-sm" onclick="addEditorRole()">Make Editor</button>
            <button class="btn btn-outline-danger btn-sm" onclick="removeEditorRole()">Remove Editor</button>
            <button class="btn btn-outline-success btn-sm" onclick="applyChanges()">Change</button>
        </div>
    </div>
</div>

<script>
	let isPublic = false;
    let users = [];

	loadStatus();
    searchEditor();

    createClickSelectAll('selectAllUser', '@classNameUserCheckBox');

	async function loadStatus() {
        isPublic = await(await GetStatusInventory(@Model.Id)).json();
		document.getElementById('checkBoxIsPublic').checked = isPublic;
	}

    function loadUsers() {
        const userList = document.getElementById('userList');
        let resHtml = "";

        for (let item of users) {
            resHtml += `
                <tr>
                    <td>
                        <input type="checkbox" class="form-check-input @classNameUserCheckBox" data-id="${item.id}">
                    </td>
                    <td>${item.name}</td>
                    <td>${item.email}</td>
                    <td>${item.roleInventory}</td>
                </tr>`;
        }

        userList.innerHTML = resHtml;
    }

    async function addEditorRole() {
        const items = await getSelected('@classNameUserCheckBox');

        await MakeEditor(items,@Model.Id);
    }

    async function removeEditorRole() {
        const items = await getSelected('@classNameUserCheckBox');

        await RemoveEditor(items,@Model.Id);
    }

    async function getUsers(userName, searchField) {
        const response = await GetEditorInventory(@Model.Id, userName, searchField);
        const result = await response.json();
        users = result;
        loadUsers();
    }

    async function searchEditor() {
        const inputUser = document.getElementById('inputUser');

        const searchField = getSearchField();

        await getUsers(inputUser.value, searchField);
    }

    async function changedSearchField() {
        await searchEditor();
    }

    function getSearchField() {
        const radio = document.getElementsByName('searchField');

        for (let r of radio) {
            if (r.checked) {
                return r.value;
            }
        }
    }

    async function applyChanges() {
        const isPublic = document.getElementById('checkBoxIsPublic').checked;

        await UpdateStatusInventory(@Model.Id, isPublic);
    }
</script>