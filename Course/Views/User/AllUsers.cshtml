<div>
    <table>
        <thead>
            <tr>
                <th>
                    <input type="checkbox" id="selectAll">
                </th>
                <th>Email</th>
                <th>Role</th>
                <th>StatusBlock</th>
            </tr>
        </thead>
        <tbody id="userList">
        </tbody>
    </table>
    <button onclick="btnDelete()">Delete</button>
    <button onclick="btnBlock()">Block</button>
    <button onclick="btnUnBlock()">Unblock</button>
    <button onclick="btnMakeAdmin()">MakeAdmin</button>
    <button onclick="btnRemoveAdmin()">RemoveAdmin</button>
</div>

<script src="~/js/MainFunction.js"></script>
<script>
    const classNameChekBoxes = "checkboxUserList";
    const userList = document.getElementById('userList');
    loadUser();

    async function loadUser() {
        if (userList?.firstChild) { 
            userList?.removeChild(userList.firstChild);
        }

        const allUsers = await GetAllUsers();
        let resHtml = "";

        for (let user of allUsers) {
                resHtml +=` 
                <tr>
                    <td>
                        <input type="checkbox" class="${classNameChekBoxes}" data-id="${user.id}" >
                    </td>
                    <td > ${user.email} </td>
                    <td > ${user.role.join(', ')} </td>
                    <td > ${user.isBlocked ? 'Blocked' : 'UnBlocked'} </td>
                </tr>`;
        }

        userList.innerHTML = resHtml;
    }

    async function btnDelete(){ 
        await DeleteUsers(getSelected(classNameChekBoxes));
        loadUser();
    }

    async function btnBlock() {
        await BlockUsers(getSelected(classNameChekBoxes));
        loadUser();
    }

    async function btnUnBlock() {
        await UnblockUsers(getSelected(classNameChekBoxes));
        loadUser();
    }

    async function btnMakeAdmin() {
        await MakeAdmin(getSelected(classNameChekBoxes));
        loadUser();
    }

    async function btnRemoveAdmin() {
        await RemoveAdmin(getSelected(classNameChekBoxes));
        loadUser();
    }
</script>