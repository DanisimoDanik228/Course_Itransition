@{
    var classNameCheckBox = "checkboxUserList";
}

<div>
    <table>
        <thead>
            <tr>
                @if (@User.IsInRole("Admin"))
                {
                    <th>
                        <input type="checkbox" id="selectAll">
                    </th>
                }
                <th>Email</th>
                <th>Role</th>
                <th>StatusBlock</th>
            </tr>
        </thead>
        <tbody id="userList">
        </tbody>
    </table>
    @if (@User.IsInRole("Admin"))
    {
        <button onclick="btnDelete()">Delete</button>
        <button onclick="btnBlock()">Block</button>
        <button onclick="btnUnBlock()">Unblock</button>
        <button onclick="btnMakeAdmin()">MakeAdmin</button>
        <button onclick="btnRemoveAdmin()">RemoveAdmin</button>
    }
</div>

<script>
    const userList = document.getElementById('userList');
    const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");

    let allUsers = [];
    
    loadUser();

    if (isAdmin) {
        createClickSelectAll('selectAll', '@classNameCheckBox');
    }

    async function loadUser() {
        await getUsers();
        let resHtml = "";

        for (let user of allUsers) {
            let checkbox = isAdmin
                ? `<td>
                    <input type="checkbox" class="@classNameCheckBox" data-id="${user.id}" >
                </td>`
                : ``;

            resHtml +=` 
            <tr>
                ${checkbox}
                <td > ${user.email} </td>
                <td > ${user.role.join(', ')} </td>
                <td > ${user.isBlocked ? 'Blocked' : 'UnBlocked'} </td>
            </tr>`;
        }

        userList.innerHTML = resHtml;
    }

    async function btnDelete(){ 
        await DeleteUsers(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnBlock() {
        await BlockUsers(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnUnBlock() {
        await UnblockUsers(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnMakeAdmin() {
        await MakeAdmin(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnRemoveAdmin() {
        await RemoveAdmin(getSelected('@classNameCheckBox'));
        
        loadUser();
    }

    async function getUsers() {
        response = await GetAllUsers();
        allUsers = await response.json();
    }
</script>