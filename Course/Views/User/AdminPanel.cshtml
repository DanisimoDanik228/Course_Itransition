@{
    var classNameCheckBox = "checkboxUserList";
}
<div class="d-flex justify-content-between border-bottom p-2">
    <div>
        <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2 p-1" href="/Home/PersonalPage">My PersonalPage</a>
        <a class="btn btn-outline-info text-decoration-none btn-sm rounded-2 p-1" href="/Home/MainPage">Main Page</a>
    </div>
    <button onclick="changeTheme()" class="btn btn-outline-secondary btn-sm rounded-2">
        Theme
    </button>
</div>

<div class="table-responsive rounded border">
    <div class="p-2">
        <table class="table table-bordered table-hover mb-0">
            <thead>
                <tr>
                    @if (@User.IsInRole("Admin"))
                    {
                        <th>
                            <input type="checkbox" class="form-check-input" id="selectAll">
                        </th>
                    }
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>StatusBlock</th>
                </tr>
            </thead>
            <tbody id="userList">
            </tbody>
        </table>
        <div class="border-top p-2">
            @if (@User.IsInRole("Admin"))
            {
                <button class="btn btn-outline-danger btn-sm" onclick="btnDelete()">Delete</button>
                <div class="btn-group">
                    <button class="btn btn-outline-warning btn-sm" onclick="btnBlock()">Block</button>
                    <button class="btn btn-outline-danger btn-sm" onclick="btnUnBlock()">Unblock</button>
                </div>
                <div class="btn-group">
                    <button class="btn btn-outline-warning btn-sm" onclick="btnMakeAdmin()">MakeAdmin</button>
                    <button class="btn btn-outline-danger btn-sm" onclick="btnRemoveAdmin()">RemoveAdmin</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    const userList = document.getElementById('userList');
    const isAdmin = @(User.IsInRole("Admin") ? "true" : "false");

    let allUsers = [];
    
    loadUser();

    if (isAdmin) {
        createClickSelectAll('selectAll', '@classNameCheckBox');
    }

    async function loadUser() {
        await getUsers();
        let resHtml = "";

        for (let user of allUsers) {
            let checkbox = isAdmin
                ? `<td>
                        <input type="checkbox" class="form-check-input @classNameCheckBox" data-id="${user.id}" >
                </td>`
                : ``;

            resHtml +=` 
            <tr>
                ${checkbox}
                <td > ${user.name} </td>
                <td > ${user.email} </td>
                <td > ${user.role.join(', ')} </td>
                <td > ${user.isBlocked ? 'Blocked' : 'UnBlocked'} </td>
            </tr>`;
        }

        userList.innerHTML = resHtml;
    }

    async function btnDelete(){ 
        await DeleteUsers(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnBlock() {
        await BlockUsers(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnUnBlock() {
        await UnblockUsers(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnMakeAdmin() {
        await MakeAdmin(getSelected('@classNameCheckBox'));

        loadUser();
    }

    async function btnRemoveAdmin() {
        await RemoveAdmin(getSelected('@classNameCheckBox'));
        
        loadUser();
    }

    async function getUsers() {
        response = await GetAllUsers();
        allUsers = await response.json();
    }
</script>